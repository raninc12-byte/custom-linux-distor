# GPU drivers - both stacks shipped, first-boot script picks the right one.
# nvidia-open only supports Turing+ cards; aibase-gpu-detect falls back to
# downloading the proprietary 'nvidia' package at runtime for older GPUs
# (not bundled here to keep the ISO smaller - requires internet on first boot).
mesa
xf86-video-amdgpu
xf86-video-ati
xf86-video-intel
vulkan-intel
vulkan-radeon
nvidia-open
nvidia-utils
nvidia-settings
lib32-nvidia-utils

# Calamares installer
calamares
kpmcore
parted

# AI stack
ollama

# ai-assistant is installed from the project's custom local repo (see
# scripts/build-local-repo.sh) - not in the official Arch repos.
ai-assistant
